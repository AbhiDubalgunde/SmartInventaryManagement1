<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="horizontal"

    android:padding="16dp"

    android:layout_marginBottom="14dp"

    android:gravity="center_vertical"

    android:background="@drawable/notification_modern_bg">

    <!-- ICON -->

    <ImageView
        android:id="@+id/imgNotification"

        android:layout_width="52dp"
        android:layout_height="52dp"

        android:src="@drawable/alerts"

        android:background="@drawable/notification_icon_bg"

        android:padding="10dp"

        android:scaleType="centerInside"/>

    <!-- TEXT SECTION -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_weight="1"

        android:orientation="vertical"

        android:layout_marginStart="14dp">

        <!-- TITLE -->

        <TextView
            android:id="@+id/tvNotificationTitle"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Milk running low"

            android:textStyle="bold"

            android:textSize="16sp"

            android:textColor="?android:textColorPrimary"/>

        <!-- DESCRIPTION -->

        <TextView
            android:id="@+id/tvNotificationDesc"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Only 2 items remaining"

            android:textSize="13sp"

            android:textColor="?android:textColorSecondary"

            android:layout_marginTop="4dp"/>

        <!-- TIME -->

        <TextView
            android:id="@+id/tvTime"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Just now"

            android:textSize="11sp"

            android:textColor="#9E9E9E"

            android:layout_marginTop="6dp"/>

    </LinearLayout>

    <!-- ACTION BUTTON -->

    <Button
        android:id="@+id/btnAction"

        android:layout_width="wrap_content"
        android:layout_height="40dp"

        android:text="Restock"

        android:textAllCaps="false"

        android:textStyle="bold"

        android:textColor="@android:color/white"

        android:textSize="12sp"

        android:backgroundTint="#2979FF"/>

</LinearLayout>